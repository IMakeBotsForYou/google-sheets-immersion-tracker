# Secrets and environment-specific values.
#
#   cp .env.example .env        (.env is git-ignored - never commit it)

# The id of your spreadsheet: docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=your-spreadsheet-id

# Path to the Google service-account key. Relative paths start at the project folder.
# Default: credentials/service_account.json
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Or paste the key's JSON on ONE line (handy on servers / CI where a file is awkward). Wins over the file.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Keep config.toml / people.json / .env / credentials/ somewhere else than the project folder:
# IMMERSION_TRACKER_HOME=/path/to/private/folder
